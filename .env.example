# Copy to .env.local and fill in. Never commit .env.local.

# --- Database (Neon) ---
# DATABASE_URL is the pooled connection ("-pooler" in the host) — the app uses it.
# DIRECT_URL is the unpooled one — Prisma migrations use it.
DATABASE_URL=
DIRECT_URL=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Upstream: railway ---
# Truthful, self-identifying. Never a browser string.
RAIL_USER_AGENT="AvestaBot/0.1 (+https://avesta.uz/contact)"

# --- Upstream: buses ---
BUS_API_TOKEN=

# --- Business ---
SERVICE_FEE_PERCENT=10
USD_RATE_SUM=

# --- Admin (single operator, MVP) ---
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# --- Payment: bank transfer details shown to tourists ---
BANK_NAME=
BANK_ACCOUNT=
BANK_RECIPIENT=

# --- File uploads: receipts and ticket PDFs (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=

# --- Email delivery ---
RESEND_API_KEY=
MAIL_FROM=

# --- Telegram delivery (existing bot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
